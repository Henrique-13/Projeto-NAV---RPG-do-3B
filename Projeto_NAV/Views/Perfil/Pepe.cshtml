@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>HANGAR</title>
    <link rel="stylesheet" href="~/css/perfilPepe.css" asp-append-version="true" />
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="hazard-bar"></div>

    <div class="container">

        <h1>HANGAR</h1>
        <h2>Ficha de Combate // Alvo: Kaiju</h2>

        <div class="box">
            Selecione uma carta de ataque para cada rodada.
        </div>

        <div class="dossier">

            <div class="dossier-side">
                <div class="panel">
                    <h3>Robô</h3>
                    <div class="slot char-slot">
                        <img id="roboImg" src="data:image/png;base64," alt="Robô - Frente">
                    </div>
                    <div class="angle-picker">
                        <button class="angle-btn active" data-target="roboImg" data-src="data:image/png;base64," data-label="Frente - Robô">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="roboImg" data-src="data:image/png;base64," data-label="Lado A - Robô">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="roboImg" data-src="data:image/png;base64," data-label="Lado B - Robô">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="roboImg" data-src="data:image/png;base64," data-label="Costas - Robô">
                            <img src="data:image/png;base64," alt="">
                        </button>
                    </div>
                </div>

                <div class="panel">
                    <h3>Personagem</h3>
                    <div class="slot char-slot">
                        <img id="charImg" src="data:image/png;base64," alt="Personagem - Frente">
                    </div>
                    <div class="angle-picker">
                        <button class="angle-btn active" data-target="charImg" data-src="data:image/png;base64," data-label="Frente - Personagem">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="charImg" data-src="data:image/png;base64," data-label="Lado A - Personagem">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="charImg" data-src="data:image/png;base64," data-label="Lado B - Personagem">
                            <img src="data:image/png;base64," alt="">
                        </button>
                        <button class="angle-btn" data-target="charImg" data-src="data:image/png;base64," data-label="Costas - Personagem">
                            <img src="data:image/png;base64," alt="">
                        </button>
                    </div>
                </div>
            </div>

            <div class="dossier-main">

                <div class="readout">
                    <h3>Status</h3>
                    <div class="statbar">
                        <div class="stat-row">
                            <div class="stat-top"><span>&#10084; Vida</span><span>20</span></div>
                            <div class="stat-bar"><i style="width:100%"></i></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-top"><span>&#128737; Defesa</span><span>0</span></div>
                            <div class="stat-bar"><i style="width:0%"></i></div>
                        </div>
                        <div class="stat-row">
                            <div class="stat-top"><span>&#128168; Agilidade</span><span>0</span></div>
                            <div class="stat-bar"><i style="width:0%"></i></div>
                        </div>
                        <div class="stat-row alert">
                            <div class="stat-top"><span>&#128165; Dano Extra</span><span>0</span></div>
                            <div class="stat-bar"><i style="width:0%"></i></div>
                        </div>
                    </div>
                </div>

                <div class="cards-heading">
                    <h3>Cartas de Ataque</h3>
                    <span>13 cartas // 1 por rodada</span>
                </div>

                <div class="cards">
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">A</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">2</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">3</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">4</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">5</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">6</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">7</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">8</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">9</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">Soco</span><span class="card-value">10</span><span class="card-dano">Dano: 3</span></div>
                    <div class="card"><span class="card-ability">&nbsp;</span><span class="card-value">J</span><span class="card-dano"></span></div>
                    <div class="card"><span class="card-ability">&nbsp;</span><span class="card-value">Q</span><span class="card-dano"></span></div>
                    <div class="card"><span class="card-ability">&nbsp;</span><span class="card-value">K</span><span class="card-dano"></span></div>
                </div>

                <a class="back" href="#">&larr; Voltar &agrave; Sele&ccedil;&atilde;o de Hangar</a>
            </div>

        </div>

    </div>

    <script src="script.js"></script>
</body>
</html>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/perfilMarina.css" asp-append-version="true" />


    <title>Marina</title>


    <link rel="stylesheet" href="style-marina.css">


</head>
<body>


    <a href="index.html" class="seta esquerda">&#10094;</a>
    <a href="index.html" class="seta direita">&#10095;</a>


    <div class="container">


        <h1>MARINA</h1>


        <div class="imagens">


            <div class="imagem">
               
                <img src="~/IMG/skin-marina.jpg" alt="Skin da Marina">
                <p>Marinoca</p>
            </div>


            <div class="imagem">
           
                  <img src="~/IMG/mecha-marina.jpg" alt="Mecha da Marina">
                <p>Barbieri</p>
            </div>


        </div>


        <div class="card">


            <h2>Nome do Mecha</h2>
            <p>BARBIERI</p>


            <h2>Nome da pilota</h2>
            <p>MARINOCA</p>


            <h2>Função</h2>
            <p>Barbieri tem o papel de ajudar Marinoca durante as batalhas.</p>



            <section class="ataques">

                <h2>Ataques </h2>

                <table>

                    <tr>
                        <th>Carta</th>
                        <th>Ataque</th>
                        <th>Dano</th>
                    </tr>

                    <tr><td>A</td><td>Soco</td><td>3</td></tr>
                    <tr><td>2</td><td>Soco</td><td>3</td></tr>
                    <tr><td>3</td><td>Soco</td><td>3</td></tr>
                    <tr><td>4</td><td>Soco</td><td>3</td></tr>
                    <tr><td>5</td><td>Soco</td><td>3</td></tr>
                    <tr><td>6</td><td>Soco</td><td>3</td></tr>
                    <tr><td>7</td><td>Soco</td><td>3</td></tr>
                    <tr><td>8</td><td>Soco</td><td>3</td></tr>
                    <tr><td>9</td><td>Soco</td><td>3</td></tr>
                    <tr><td>10</td><td>Soco</td><td>3</td></tr>
                    <tr><td>J</td><td>nada</td><td>0</td></tr>
                    <tr><td>Q</td><td>nada</td><td>0</td></tr>
                    <tr><td>K</td><td>nada</td><td>0</td></tr>

                </table>

            </section>

        </div>


    </div>


</body>
</html>
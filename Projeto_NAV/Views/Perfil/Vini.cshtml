@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Combate</title>

    <link rel="stylesheet" href="~/css/perfilVini.css" asp-append-version="true" />
</head>

<body>

    <header>
        <h1>Sistema de Combate</h1>
    </header>

    <nav>
        <a href="index.html">VINICIUS</a>
    </nav>

    <section class="arena">

        <div class="lutador">

            <img src="~/img/personagem_e_robo.png" alt="Mecha">

            <h2>VINICIUS / MECHA</h2>

            <table>

                <tr>
                    <th>Atributo</th>
                    <th>Valor</th>
                </tr>

                <tr>
                    <td>Vida</td>
                    <td class="coracao">25 ❤</td>
                </tr>

                <tr>
                    <td>Ataque</td>
                    <td>1</td>
                </tr>

                <tr>
                    <td>Defesa</td>
                    <td>-</td>
                </tr>

                <tr>
                    <td>Agilidade</td>
                    <td>-</td>
                </tr>

            </table>

        </div>

    </section>

    <section class="ataques">

        <h2>Ataques</h2>

        <table>

            <tr>
                <th>Carta</th>
                <th>Ataque</th>
                <th>Dano</th>
            </tr>

            <tr><td>A</td><td>Soco</td><td>3</td></tr>
            <tr><td>2</td><td>Soco</td><td>3</td></tr>
            <tr><td>3</td><td>Soco</td><td>3</td></tr>
            <tr><td>4</td><td>Soco</td><td>3</td></tr>
            <tr><td>5</td><td>Soco</td><td>3</td></tr>
            <tr><td>6</td><td>Soco</td><td>3</td></tr>
            <tr><td>7</td><td>Soco</td><td>3</td></tr>
            <tr><td>8</td><td>Soco</td><td>3</td></tr>
            <tr><td>9</td><td>Soco</td><td>3</td></tr>
            <tr><td>10</td><td>Soco</td><td>3</td></tr>
            <tr><td>J</td><td>-</td><td>-</td></tr>
            <tr><td>Q</td><td>-</td><td>-</td></tr>
            <tr><td>K</td><td>-</td><td>-</td></tr>

        </table>

    </section>

</body>

</html>
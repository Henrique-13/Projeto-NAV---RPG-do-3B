<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Perfil de Combatente</title>

    <link rel="stylesheet" href="~/css/perfilLucas.css" asp-append-version="true" />

    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

</head>

<body>

    <div class="container">

        <h1>PERFIL DE COMBATENTE</h1>


        <!-- COMBATENTE -->

        <section class="bloco">

            <h2>COMBATENTE</h2>

            <div class="linha-imagens">

                <div class="personagem">

                    <img src="~/IMG/personagem.png" alt="Personagem Frente">

                    <p>FRENTE</p>

                </div>


                <div class="personagem">

                    <img src="personagem2.png" alt="Personagem Costas">

                    <p>COSTAS</p>

                </div>

            </div>

        </section>

        <!-- MECHA -->

        <section class="bloco">

            <h2>MECHA</h2>

            <div class="linha-imagens">

                <div class="personagem">

                    <img src="mecha.png" alt="Mecha Frente">

                    <p>FRENTE</p>

                </div>


                <div class="personagem">

                    <img src="mecha2.png" alt="Mecha Costas">

                    <p>COSTAS</p>

                </div>

            </div>

        </section>


        <!-- STATUS -->

        <section class="bloco status">

            <h2>STATUS</h2>

            <table>

                <tr>
                    <th>Atributo</th>
                    <th>Valor</th>
                </tr>

                <tr>
                    <td>Vida</td>
                    <td><input type="number"></td>
                </tr>

                <tr>
                    <td>Agilidade</td>
                    <td><input type="number"></td>
                </tr>

                <tr>
                    <td>Dano Extra</td>
                    <td><input type="number"></td>
                </tr>

                <tr>
                    <td>Defesa</td>
                    <td><input type="number"></td>
                </tr>

            </table>

        </section>


        <!-- HABILIDADES -->

        <section class="bloco">

            <h2>HABILIDADES</h2>

            <div class="tabela-habilidades">

                <table id="tabelaHabilidades">

                    <tr>

                        <th>Carta</th>
                        <th>Nome</th>
                        <th>Força</th>
                        <th>Descrição</th>

                    </tr>

                    <tr>
                        <td>A</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>2</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>3</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>4</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>5</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>6</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>7</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>8</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>9</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>10</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>J</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>Q</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                    <tr>
                        <td>K</td>
                        <td><input></td>
                        <td><input type="number"></td>
                        <td><input></td>
                    </tr>

                </table>

            </div>

        </section>

    </div>

    <script src="script.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>

</html>
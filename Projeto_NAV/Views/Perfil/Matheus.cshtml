@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/PerfilMatheus.css" asp-append-version="true" />
    <title>Guerreiro Mecha</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>FICHA DO GUERREIRO MECHA</h1>

        <p>
            Personagem • Mecha • Status • Ataques
        </p>
    </header>


    <main>

        <section class="painel-principal">

            <!-- PERSONAGEM -->
            
            <div class="card personagem">

                <h2>Matheus</h2>

                <img src="~/img/personagem.png"
                     alt="Meu personagem">
            </div>

            <!-- STATUS -->

            <div class="card status">

                <h2>STATUS</h2>

                <p class="texto-status">
                    Atributos atuais do guerreiro.
                </p>


                <div class="status-caixa">

                    <span>
                        🛡 DEFESA
                    </span>

                    <strong>
                        0
                    </strong>

                </div>


                <div class="status-caixa">

                    <span>
                        ⚔ DANO EXTRA
                    </span>

                    <strong>
                        0
                    </strong>

                </div>


                <div class="status-caixa">

                    <span>
                        ⚡ AGILIDADE
                    </span>

                    <strong>
                        0
                    </strong>

                </div>


                <div class="status-caixa">

                    <span>
                        ❤ VIDA
                    </span>

                    <strong>
                        20
                    </strong>

                </div>


            </div>

            <!-- MECCHA -->

            <div class="card mecha">

                <h2>MECHA</h2>

                <img src="~/img/Mecha.png"
                     alt="Meu Mecha">

            </div>

        </section>


        <!-- ATAQUES -->

        <section class="ataques">

            <h2>LISTA DE ATAQUES</h2>

            <div class="lista-ataques">

                <button class="ataque">
                    <strong>A</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>2</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>3</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>4</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>5</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>6</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>7</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>8</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>9</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>10</strong>
                    <span>Soco</span>
                    <small>3 de dano</small>
                </button>

                <button class="ataque">
                    <strong>J</strong>
                    <span>Olho do porco</span>
                    <small>Suporte</small>
                    <small>Passiva:Visão do Porco Caído: Permite ver as próximas 3 cartas do topo do baralho e colocar uma no topo, garantindo o próximo saque.</small>
                </button>

                <button class="ataque">
                    <strong>Q</strong>
                    <span>ND</span>
                    <small></small>
                </button>

                <button class="ataque">
                    <strong>K</strong>
                    <span>ND</span>
                    <small></small>
                </button>

            </div>

        </section>

    </main>


    <footer>

        FICHA DO GUERREIRO MECCHA

    </footer>


</body>
</html>